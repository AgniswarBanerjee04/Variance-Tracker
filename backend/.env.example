# Application Configuration
APP_NAME="Variance Tracker API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration
# For local dev without Postgres, fallback to SQLite async or configure your Postgres instance:
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/variance_tracker
# SQLite fallback: sqlite+aiosqlite:///./variance_tracker.db
DATABASE_URL="sqlite+aiosqlite:///./variance_tracker.db"

# JWT Security
SECRET_KEY="super-secret-mca-minor-project-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anomaly Detection Defaults
MICRO_SPEND_THRESHOLD=500.00

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
