# Application Configuration
APP_NAME="Variance Tracker API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (Cloud PostgreSQL)
# Example PostgreSQL URL (Supabase, Neon, AWS RDS, Render, Vercel Postgres):
# postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/variance_tracker"

# JWT Security
SECRET_KEY="super-secret-mca-minor-project-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anomaly Detection Defaults
MICRO_SPEND_THRESHOLD=500.00

# CORS
CORS_ORIGINS=["https://variance-tracker-x56m.vercel.app","http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
